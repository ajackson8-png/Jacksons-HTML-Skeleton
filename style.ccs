/* PART 1: COLORS AND BACKGROUND */
body {
    background-color: #293D7F;
    color: #ffffff;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

/* PART 2: HEADINGS */
h1, h2, h3 {
    color: #eab676;
}

h1 {
    font-size: 3rem;
}

h2 {
    font-size: 2rem;
}

/* PART 3: PARAGRAPHS - TYPE SELECTOR */
p {
    font-size: 1.2rem;
    line-height: 1.5;
}

/* PART 4: HEADER - BOX MODEL */
header {
    background-color: #1c2d60;
    text-align: center;
    margin-bottom: 20px;
    padding: 25px;
    border-bottom: 4px solid #eab676;
}

/* PART 5: NAVIGATION */
nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
}

nav a {
    color: #ffffff;
    text-decoration: none;
    padding: 10px;
    border: 2px solid #eab676;
    border-radius: 5px;
    display: inline-block;
}

nav a:hover {
    background-color: #eab676;
    color: #293D7F;
}

/* PART 6: MAIN CONTENT */
main {
    max-width: 900px;
    margin: 20px auto;
    padding: 20px;
}

/* PART 7: SECTIONS - BOX MODEL */
section {
    background-color: #ffffff;
    color: #293D7F;
    margin-bottom: 20px;
    padding: 25px;
    border: 3px solid #eab676;
    border-radius: 10px;
}

/* PART 8: CLASS SELECTOR */
.highlight {
    background-color: #fff0d2;
    color: #293D7F;
    padding: 15px;
    margin: 10px 0;
    border-left: 5px solid #eab676;
}

/* PART 9: ID SELECTOR - BOX MODEL */
#about-me {
    background-color: #edf2ff;
    color: #293D7F;
    margin-top: 20px;
    padding: 25px;
    border: 3px solid #5f7a23;
}

/* PART 10: FOOTER */
footer {
    background-color: #1c2d60;
    color: #ffffff;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
    border-top: 4px solid #eab676;
}
